# Names only — never commit values. Required variables have no defaults;
# the server refuses to start if they are missing.

# Database (cmd/migrate also accepts DATABASE_URL instead of the DB_* variables)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=          # required
DB_NAME=
DB_SSLMODE=           # optional, default "require" (disable|allow|prefer|require|verify-ca|verify-full)

# Auth
JWT_SECRET=           # required, at least 32 characters

# Server
PORT=
APP_ENV=              # optional; "development" enables Gin debug mode, anything else runs release mode
ENABLE_DOCS=          # optional; "true" serves Swagger UI at /swagger/index.html
ALLOWED_ORIGINS=
TRUSTED_PROXIES=      # optional, comma-separated proxy IPs/CIDRs; empty trusts none
TRUSTED_IP_HEADER=    # optional, header the platform always sets to the real client IP

# Analytics service (Railway private network, e.g. http://<service>.railway.internal:<PORT>)
PYTHON_SERVICE_URL=   # required
INTERNAL_JWT_SECRET=  # required, at least 32 characters, different from JWT_SECRET; same value on the Python service

# Optional first-admin seed: runs only if both are set and the password has at least 12 characters
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
